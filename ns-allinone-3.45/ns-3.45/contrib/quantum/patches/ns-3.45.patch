     return sqlite3_column_double(stmt, pos);
 }
 
+/// @copydoc SQLiteOutput::RetrieveColumn
+template <>
+std::string
+SQLiteOutput::RetrieveColumn(sqlite3_stmt* stmt, int pos) const
+{
+    const char* text = reinterpret_cast<const char*>(sqlite3_column_text(stmt, pos));
+    if (text == nullptr)
+    {
+        return "";
+    }
+    return std::string(text);
+}
+
 template <typename T>
 bool
 SQLiteOutput::Bind(sqlite3_stmt* /* stmt */, int /* pos */, const T& /* value */) const
@@ -188,6 +201,21 @@ SQLiteOutput::Bind(sqlite3_stmt* stmt, int pos, const std::string& value) const
     return sqlite3_bind_text(stmt, pos, value.c_str(), -1, SQLITE_STATIC) == SQLITE_OK;
 }
 
+//! \copydoc SQLiteOutput::Bind
+template <>
+bool
+SQLiteOutput::Bind(sqlite3_stmt* stmt, int pos, const int128_t& value) const
+{
+    return sqlite3_bind_int64(stmt, pos, value) == SQLITE_OK;
+}
+
+//! \copydoc SQLiteOutput::BindNull
+bool
+SQLiteOutput::BindNull(sqlite3_stmt* stmt, int pos) const
+{
+    return sqlite3_bind_null(stmt, pos) == SQLITE_OK;
+}
